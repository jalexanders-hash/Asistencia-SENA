rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    
    function incoming() { return request.resource.data; }
    
    function isValidFicha(data) {
      return data.keys().hasAll(['fechas_asistencia', 'asistencias_aprendices', 'equipo_instructores'])
        && data.fechas_asistencia is list
        && data.asistencias_aprendices is list
        && data.equipo_instructores is list;
    }

    // Función auxiliar para verificar si el usuario es el Administrador Global
    function esAdminGlobal() {
      return request.auth != null && 
        request.auth.token.email == "jalexanders@gmail.com";
    }

    // Función auxiliar para verificar si el usuario es Coordinador Académico
    function esCoordinadorAcademico() {
      return request.auth != null && (
        esAdminGlobal() ||
        request.auth.token.email.matches('.*coordinacion.*@misena\\.edu\\.co') ||
        request.auth.token.email == "coordinacion.academica@sena.edu.co"
      );
    }

    // Función auxiliar para verificar si el instructor es el líder formal de la ficha
    function esInstructorLider(fichaData) {
      return request.auth != null && fichaData.equipo_instructores is list &&
        fichaData.equipo_instructores.hasAny([
          { 'correo_institucional_sena': request.auth.token.email, 'rol': 'Instructor Lider' },
          { 'correo_institucional': request.auth.token.email, 'rol': 'Instructor Lider' },
          { 'correo_gmail': request.auth.token.email, 'rol': 'Instructor Lider' },
          { 'correo_institucional_sena': request.auth.token.email, 'es_lider': true },
          { 'correo_institucional': request.auth.token.email, 'es_lider': true }
        ]);
    }

    // Función para validar si el instructor autenticado forma parte del equipo ejecutor de la ficha
    function esInstructorAutorizado(fichaData) {
      return request.auth != null && (
        esCoordinadorAcademico() ||
        esInstructorLider(fichaData) ||
        (fichaData.equipo_instructores is list &&
          fichaData.equipo_instructores.hasAny([
            { 'correo_institucional_sena': request.auth.token.email },
            { 'correo_institucional': request.auth.token.email },
            { 'correo_gmail': request.auth.token.email },
            { 'correo': request.auth.token.email }
          ])
        )
      );
    }

    // Reglas para Fichas de Caracterización
    match /fichas/{fichaId} {
      // Lectura permitida para cualquier usuario autenticado o vinculado
      allow read: if request.auth != null;
      
      // Creación permitida para Admin o Coordinador Académico
      allow create: if isValidId(fichaId) && isValidFicha(incoming()) && (esAdminGlobal() || esCoordinadorAcademico());
      
      // Actualización protegida por RBAC (Admin, Coordinador o Instructor Líder/Autorizado)
      allow update: if isValidId(fichaId) 
        && isValidFicha(incoming())
        && (esCoordinadorAcademico() || esInstructorLider(resource.data) || esInstructorAutorizado(resource.data))
        && incoming().diff(resource.data).affectedKeys().hasOnly([
             'fechas_asistencia', 
             'asistencias_aprendices', 
             'equipo_instructores', 
             'fechas_por_instructor', 
             'ficha_de_caracterizacion', 
             'programa', 
             'centro', 
             'denominacion'
           ]);

      // Eliminación restringida al Administrador Global o Coordinador Académico
      allow delete: if esAdminGlobal() || esCoordinadorAcademico();
    }

    // Reglas para el Módulo de Auditoría y Trazabilidad (Logs Inmutables)
    match /logs_auditoria/{logId} {
      // El administrador o coordinador lee todo; los instructores solo sus propias trazas
      allow read: if request.auth != null && (
        esCoordinadorAcademico() || resource.data.correo_usuario == request.auth.token.email
      );

      // Cualquier usuario autenticado puede generar trazas de auditoría al registrar acciones
      allow create: if request.auth != null;

      // INMUTABILIDAD ESTRICTA: Los logs nunca se pueden modificar ni eliminar por nadie
      allow update, delete: if false;
    }
  }
}
